set(GX ${CMAKE_CURRENT_SOURCE_DIR}/vendor/genesis-plus-gx)
set(GX_DIRS core core/z80 core/m68k core/ntsc core/sound core/sound/minimp3 core/sound/tremor core/input_hw core/cd_hw core/cart_hw core/cart_hw/svp)
set(GX_SOURCES)
set(GX_INCLUDES ${CMAKE_CURRENT_SOURCE_DIR}/vendor/zlib ${GX}/libretro ${GX}/libretro/libretro-common/include)
foreach(d ${GX_DIRS})
  file(GLOB files CONFIGURE_DEPENDS ${GX}/${d}/*.c)
  list(APPEND GX_SOURCES ${files})
  # Tremor includes its own headers relative to each source. Adding this directory
  # globally shadows Apple's system Block.h on case-insensitive filesystems.
  if(NOT d STREQUAL "core/sound/tremor")
    list(APPEND GX_INCLUDES ${GX}/${d})
  endif()
endforeach()
foreach(f streams/file_stream.c streams/file_stream_transforms.c compat/fopen_utf8.c compat/compat_snprintf.c compat/compat_strl.c compat/compat_strcasestr.c compat/compat_posix_string.c encodings/encoding_utf.c file/file_path.c file/retro_dirent.c lists/string_list.c lists/dir_list.c memmap/memalign.c string/stdstring.c vfs/vfs_implementation.c)
  list(APPEND GX_SOURCES ${GX}/libretro/libretro-common/${f})
endforeach()
foreach(f adler32.c crc32.c inffast.c inflate.c inftrees.c zutil.c)
  list(APPEND GX_SOURCES ${CMAKE_CURRENT_SOURCE_DIR}/vendor/zlib/${f})
endforeach()
list(APPEND GX_SOURCES ${GX}/libretro/libretro.c src/observer.c)
add_library(scu_core STATIC ${GX_SOURCES})
target_include_directories(scu_core PRIVATE ${GX_INCLUDES} ${CMAKE_CURRENT_SOURCE_DIR}/src)
target_compile_definitions(scu_core PRIVATE LSB_FIRST BYTE_ORDER=1234 LITTLE_ENDIAN=1234 USE_16BPP_RENDERING FRONTEND_SUPPORTS_RGB565 USE_LIBTREMOR HAVE_ZLIB HAVE_NO_LANGEXTRA MAXROMSIZE=10485760 HAVE_YM3438_CORE HAVE_OPLL_CORE __LIBRETRO__ USE_LIBRETRO_VFS)
if(NOT MSVC)
  target_link_libraries(scu_core PUBLIC m)
  # Upstream uses GNU89 external-inline semantics even with C99 syntax.
  target_compile_options(scu_core PRIVATE -fgnu89-inline -Wno-incompatible-pointer-types -Wno-deprecated-declarations)
endif()
